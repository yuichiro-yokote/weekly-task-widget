<Window x:Class="WeeklyTasks.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1週間のタスク" Width="1000" Height="760" MinWidth="760" MinHeight="680" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Yu Gothic UI, Segoe UI" FontSize="14" ShowInTaskbar="True" Topmost="True">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="TaskCard">
      <Button Click="Task_Click" HorizontalContentAlignment="Stretch" Margin="0,0,0,7" Padding="12,10" ToolTip="詳細と根拠を表示">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{Binding Accent}" CornerRadius="2" Margin="0,2,0,2"/>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,6,0,0">
              <Border Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,6,2"><TextBlock Text="{Binding Badge}" Foreground="{Binding Accent}" FontSize="11" FontWeight="SemiBold"/></Border>
              <TextBlock Text="{Binding Deadline}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,2"/>
            </WrapPanel>
            <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource CanvasBrush}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource TintBrush}" CornerRadius="12,12,0,0" Padding="18,14,12,13" MouseLeftButtonDown="Header_MouseDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseUp">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="1週間のタスク" FontSize="19" FontWeight="Bold"/>
            <TextBlock x:Name="RangeText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="PinButton" Content="デスクトップ" Click="Pin_Click" Padding="7,4" Margin="0,0,4,0" FontSize="11" ToolTip="デスクトップとウィンドウ表示の切り替え"/>
            <Button x:Name="HideButton" Content="―" Click="Hide_Click" Padding="8,3" ToolTip="通知領域に隠す" AutomationProperties.Name="パネルを隠す"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="18,12,18,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="RefreshButton" Content="更新する" Click="Refresh_Click" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Padding="17,7" ToolTip="Codexで7日分を整理します。利用枠を消費します。"/>
        <Button x:Name="CancelButton" Content="中止" Click="Cancel_Click" Grid.Column="0" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <Button Grid.Column="1" Content="ホーム" Click="Home_Click" Margin="0,0,7,0" Padding="9,7"/>
        <Button Grid.Column="2" Content="設定" Click="Settings_Click" Padding="9,7"/>
      </Grid>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,14,12" CanContentScroll="False">
        <StackPanel>
          <Border x:Name="NoticeBox" Background="{DynamicResource TintBrush}" CornerRadius="8" Padding="11" Margin="0,0,0,12">
            <TextBlock x:Name="NoticeText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" LineHeight="18"/>
          </Border>
          <ItemsControl x:Name="DaysControl">
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel Margin="0,0,0,11">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding DateLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="10,3,0,0"/></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="3,0,0,10" Visibility="{Binding EmptyVisibility}"/>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TaskCard}"/>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander x:Name="ReviewExpander" Header="確認したいこと" Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,2,0,12" Visibility="Collapsed">
            <ItemsControl x:Name="ReviewControl" ItemTemplate="{StaticResource TaskCard}" Margin="0,10,0,0"/>
          </Expander>
        </StackPanel>
      </ScrollViewer>
        <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="16,0,18,12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="カレンダー" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,9"/>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CalendarMonthText" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="‹" Click="CalendarPrevious_Click" Padding="8,3" Margin="0,0,4,0" FontSize="18" ToolTip="前の月" AutomationProperties.Name="前の月"/>
                  <Button Content="›" Click="CalendarNext_Click" Padding="8,3" Margin="0,0,6,0" FontSize="18" ToolTip="次の月" AutomationProperties.Name="次の月"/>
                  <Button Content="今日" Click="CalendarToday_Click" Padding="8,5" FontSize="11" ToolTip="今日に戻る" AutomationProperties.Name="今日に戻る"/>
                </StackPanel>
              </Grid>
              <UniformGrid Columns="7" Margin="0,0,0,5">
                <TextBlock Text="日" Foreground="{DynamicResource SundayBrush}" HorizontalAlignment="Center" FontSize="11"/>
                <TextBlock Text="月" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="火" HorizontalAlignment="Center" FontSize="11"/>
                <TextBlock Text="水" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="木" HorizontalAlignment="Center" FontSize="11"/>
                <TextBlock Text="金" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="土" Foreground="{DynamicResource SaturdayBrush}" HorizontalAlignment="Center" FontSize="11"/>
              </UniformGrid>
              <ItemsControl x:Name="CalendarDaysControl">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Click="CalendarDay_Click" Height="46" Margin="2" Padding="1,3" Background="{Binding Background}" Foreground="{Binding Foreground}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" Opacity="{Binding Opacity}" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}" HorizontalContentAlignment="Center">
                    <StackPanel>
                      <TextBlock Text="{Binding Number}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Foreground}" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Marker}" FontSize="9" Foreground="{Binding Foreground}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="件数は保存済みのタスク · 枠線は今日" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="1,8,0,14"/>
              <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,13"/>
            </StackPanel>
            <Grid Grid.Row="1">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock x:Name="CalendarSelectionText" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock x:Name="CalendarEmptyText" TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                  <ItemsControl x:Name="CalendarTasksControl" ItemTemplate="{StaticResource TaskCard}"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10,18,12">
        <StackPanel><TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock x:Name="UpdatedText" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
